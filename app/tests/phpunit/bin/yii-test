#!/usr/bin/env php
<?php

defined('YII_DEBUG') or define('YII_DEBUG', true);
defined('YII_ENV') or define('YII_ENV', 'test');

require dirname(__DIR__, 3) . '/vendor/autoload.php';
require dirname(__DIR__, 3) . '/vendor/yiisoft/yii2/Yii.php';
require dirname(__DIR__, 3) . '/common/config/bootstrap.php';
require dirname(__DIR__, 3) . '/console/config/bootstrap.php';

Yii::setAlias('tests', dirname(__DIR__, 2));
Yii::setAlias('phpunitTests', dirname(__DIR__));

require dirname(__DIR__) . '/runtime.php';

$application = new yii\console\Application(require dirname(__DIR__) . '/config/console.php');
exit($application->run());
