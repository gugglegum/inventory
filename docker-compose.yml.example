services:
  php:
    image: stockhub-php:latest
    container_name: stockhub-php
    build:
      context: .
      dockerfile: ./docker/php/Dockerfile
    environment:
      YII_ENV: "${YII_ENV:-prod}"
      YII_DEBUG: "${YII_DEBUG:-0}"
      TRUSTED_PROXIES: "${TRUSTED_PROXIES:-}"
      STOCKHUB_CANONICAL_ORIGIN: "${STOCKHUB_CANONICAL_ORIGIN:-}"
      STOCKHUB_PASSWORD_LOGIN_ENABLED: "${STOCKHUB_PASSWORD_LOGIN_ENABLED:-1}"
      STOCKHUB_SSO_LOGIN_ENABLED: "${STOCKHUB_SSO_LOGIN_ENABLED:-0}"
      OIDC_ISSUER: "${OIDC_ISSUER:-http://sso.pyrda.lc}"
      OIDC_CLIENT_ID: "${OIDC_CLIENT_ID:-}"
      OIDC_CLIENT_SECRET: "${OIDC_CLIENT_SECRET:-}"
      OIDC_REDIRECT_URI: "${OIDC_REDIRECT_URI:-http://stockhub.lc/auth/sso/callback}"
      OIDC_SCOPES: "${OIDC_SCOPES:-openid profile email}"
      OIDC_HTTP_TIMEOUT: "${OIDC_HTTP_TIMEOUT:-10}"
      OIDC_CLOCK_SKEW_SECONDS: "${OIDC_CLOCK_SKEW_SECONDS:-60}"
    extra_hosts:
      - "sso.pyrda.lc:host-gateway"
    volumes:
      - ./app:/var/www/html
      - backend_runtime:/var/www/html/backend/runtime
      - console_runtime:/var/www/html/console/runtime
      - ./docker/php/custom.ini:/usr/local/etc/php/conf.d/custom.ini
      - ./app/tmp:/tmp
    working_dir: /var/www/html
    restart: always
    depends_on:
      - db
    networks:
      - app-network

  nginx:
    image: stockhub-nginx:latest
    container_name: stockhub-nginx
    build:
      context: .
      dockerfile: ./docker/nginx/Dockerfile
    environment:
      VIRTUAL_HOST: "${STOCKHUB_VIRTUAL_HOST:-stockhub.lc}"
      VIRTUAL_PORT: 80
      VIRTUAL_NETWORK: proxy
      LETSENCRYPT_HOST: ""
    volumes:
      - ./app:/var/www/html
      - ./docker/nginx/default.conf:/etc/nginx/conf.d/default.conf
      - ./docker/nginx/blacklist.conf:/etc/nginx/blacklist.conf
      - ./docker/nginx/.htpasswd:/etc/nginx/.htpasswd
      - ./logs/nginx:/var/log/nginx
    restart: always
    depends_on:
      - php
    networks:
      - app-network
      - proxy

  db:
    image: mariadb:latest
    container_name: stockhub-db
    environment:
      MYSQL_ROOT_PASSWORD: root
      MYSQL_DATABASE: stockhub
      MYSQL_USER: stockhub
      MYSQL_PASSWORD: stockhub
    restart: always
    volumes:
      - ./db_data:/var/lib/mysql
    networks:
      - app-network

networks:
  app-network:

  proxy:
    external: true
volumes:
  db_data:
  backend_runtime:
  console_runtime:
